{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/projects/defacto", "destination": "/en/projects/defacto", "statusCode": 301 },
    { "source": "/projects/ntt-data", "destination": "/en/projects/ntt-data", "statusCode": 301 },
    { "source": "/projects/modanisa", "destination": "/en/projects/modanisa", "statusCode": 301 },
    { "source": "/projects/gwm", "destination": "/en/projects/gwm", "statusCode": 301 },
    { "source": "/projects/elm", "destination": "/en/projects/elm", "statusCode": 301 },
    { "source": "/projects/mifa", "destination": "/en/projects/mifa", "statusCode": 301 },
    { "source": "/projects/agriedge", "destination": "/en/projects/agriedge", "statusCode": 301 },
    { "source": "/projects/dilitrust", "destination": "/en/projects/dilitrust", "statusCode": 301 },
    { "source": "/projects/eqdom", "destination": "/en/projects/eqdom", "statusCode": 301 },
    { "source": "/projects/everis", "destination": "/en/projects/everis", "statusCode": 301 },
    { "source": "/projects/samsung", "destination": "/en/projects/samsung", "statusCode": 301 },
    { "source": "/projects/indrive", "destination": "/en/projects/indrive", "statusCode": 301 },
    { "source": "/fr/blog", "destination": "/en/blog", "permanent": true },
    { "source": "/fr/blog/:path*", "destination": "/en/blog/:path*", "permanent": true },
    { "source": "/fr", "destination": "/", "permanent": true },
    { "source": "/fr/:path*", "destination": "/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/rss.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
